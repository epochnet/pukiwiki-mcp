# --- Required ---
# Base URL of the PukiWiki site (the script that handles ?cmd=...).
PUKIWIKI_URL=https://wiki.example.com/

# --- Optional ---
# Internal encoding of the wiki: euc-jp (PukiWiki's Japanese default) or utf-8.
PUKIWIKI_ENCODING=euc-jp

# HTTP timeout in seconds.
PUKIWIKI_TIMEOUT=30

# TLS certificate verification (true/false).
PUKIWIKI_VERIFY_TLS=true

# Custom User-Agent (optional).
# PUKIWIKI_USER_AGENT=pukiwiki-mcp/1.0.0

# Log level (DEBUG/INFO/WARNING/ERROR). Logs go to stderr.
PUKIWIKI_LOG_LEVEL=INFO

# --- MCP transport (mainly for Docker) ---
# stdio (default) | streamable-http | sse
# compose.yml overrides this to streamable-http.
# The HTTP transports have no authentication. Keep the host on 127.0.0.1
# (compose.yml publishes the container port on the host's 127.0.0.1 only).
PUKIWIKI_MCP_TRANSPORT=stdio
PUKIWIKI_MCP_HOST=127.0.0.1
PUKIWIKI_MCP_PORT=8000

# --- Optional Basic auth (only if .htaccess enables it; default: none) ---
# PUKIWIKI_BASIC_USER=
# PUKIWIKI_BASIC_PASSWORD=
